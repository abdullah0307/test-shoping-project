rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'abdullahjavaid0307@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isActiveUserAccount() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // --- Entity Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'status',
          'companyName', 'industry', 'phone', 'planTier',
          'projectedRevenue', 'inboundCallsGrowth', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'status',
          'companyName', 'industry', 'phone', 'planTier',
          'projectedRevenue', 'inboundCallsGrowth', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.role in ['user', 'admin'] &&
        data.status in ['active', 'suspended'] &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120 &&
        data.industry is string && data.industry.size() <= 80 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.planTier in ['Growth Audit', 'Local Domination', 'Enterprise'] &&
        (data.projectedRevenue is int || data.projectedRevenue is float) &&
        data.projectedRevenue >= 0 && data.projectedRevenue <= 10000000 &&
        (data.inboundCallsGrowth is int || data.inboundCallsGrowth is float) &&
        data.inboundCallsGrowth >= 0 && data.inboundCallsGrowth <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        isValidId(data.grantedBy) &&
        data.createdAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'userId', 'userEmail', 'contactName', 'workEmail', 'companyName',
          'dateLabel', 'timeSlot', 'status', 'confirmationCode', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'userEmail', 'contactName', 'workEmail', 'companyName',
          'dateLabel', 'timeSlot', 'status', 'confirmationCode', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254 &&
        data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 100 &&
        data.workEmail is string && data.workEmail.size() >= 3 && data.workEmail.size() <= 254 &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120 &&
        data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 40 &&
        data.timeSlot is string && data.timeSlot.size() >= 1 && data.timeSlot.size() <= 20 &&
        data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        data.confirmationCode is string && data.confirmationCode.size() >= 4 && data.confirmationCode.size() <= 24 &&
        data.confirmationCode.matches('^[A-Z0-9\\-]+$') &&
        data.notes is string && data.notes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAudit(data) {
      return data.keys().hasAll([
          'userId', 'companyName', 'city', 'monthlyCalls', 'avgTicketValue',
          'monthlyAdSpend', 'currentReviews', 'projectedExtraRevenue',
          'projectedCallsLiftPct', 'visibilityScore', 'recommendations',
          'status', 'adminNotes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'companyName', 'city', 'monthlyCalls', 'avgTicketValue',
          'monthlyAdSpend', 'currentReviews', 'projectedExtraRevenue',
          'projectedCallsLiftPct', 'visibilityScore', 'recommendations',
          'status', 'adminNotes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 100 &&
        (data.monthlyCalls is int || data.monthlyCalls is float) &&
        data.monthlyCalls >= 0 && data.monthlyCalls <= 100000 &&
        (data.avgTicketValue is int || data.avgTicketValue is float) &&
        data.avgTicketValue >= 50 && data.avgTicketValue <= 1000000 &&
        (data.monthlyAdSpend is int || data.monthlyAdSpend is float) &&
        data.monthlyAdSpend >= 0 && data.monthlyAdSpend <= 1000000 &&
        (data.currentReviews is int || data.currentReviews is float) &&
        data.currentReviews >= 0 && data.currentReviews <= 100000 &&
        (data.projectedExtraRevenue is int || data.projectedExtraRevenue is float) &&
        data.projectedExtraRevenue >= 0 && data.projectedExtraRevenue <= 100000000 &&
        (data.projectedCallsLiftPct is int || data.projectedCallsLiftPct is float) &&
        data.projectedCallsLiftPct >= 0 && data.projectedCallsLiftPct <= 1000 &&
        (data.visibilityScore is int || data.visibilityScore is float) &&
        data.visibilityScore >= 0 && data.visibilityScore <= 100 &&
        data.recommendations is list && data.recommendations.size() >= 1 && data.recommendations.size() <= 5 &&
        data.recommendations[0] is string && data.recommendations[0].size() <= 300 &&
        data.status in ['submitted', 'in_review', 'blueprint_ready'] &&
        data.adminNotes is string && data.adminNotes.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().email == request.auth.token.email &&
            incoming().role == 'user' &&
            incoming().status == 'active'
          )
        );
      allow update: if isVerified() && isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'role', 'status', 'companyName',
            'industry', 'phone', 'planTier', 'projectedRevenue',
            'inboundCallsGrowth', 'updatedAt'
          ])) ||
          (isOwner(userId) &&
            existing().status == 'active' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'companyName', 'industry', 'phone', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    match /admins/{adminUid} {
      allow get: if isVerified() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(adminUid) && isValidAdminDoc(incoming()) &&
        incoming().uid == adminUid &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow get: if isVerified() && isValidId(bookingId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(bookingId) && isValidBooking(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().userEmail == request.auth.token.email &&
        incoming().status == 'pending' &&
        incoming().notes == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isActiveUserAccount();
      allow update: if isVerified() && isValidId(bookingId) && isValidBooking(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().userEmail == existing().userEmail &&
        incoming().confirmationCode == existing().confirmationCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'dateLabel', 'timeSlot', 'notes', 'updatedAt'
          ])) ||
          (existing().userId == request.auth.uid &&
            existing().status != 'completed' &&
            existing().status != 'cancelled' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    match /audits/{auditId} {
      allow get: if isVerified() && isValidId(auditId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(auditId) && isValidAudit(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'submitted' &&
        incoming().adminNotes == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isActiveUserAccount();
      allow update: if isVerified() && isValidId(auditId) && isValidAudit(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'adminNotes', 'projectedExtraRevenue', 'projectedCallsLiftPct',
            'visibilityScore', 'recommendations', 'updatedAt'
          ])) ||
          (existing().userId == request.auth.uid &&
            existing().status == 'submitted' &&
            incoming().status == existing().status &&
            incoming().adminNotes == existing().adminNotes &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'companyName', 'city', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(auditId);
    }
  }
}
